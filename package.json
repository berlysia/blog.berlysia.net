{
  "name": "berlysia-net",
  "version": "0.0.0",
  "description": "",
  "author": "berlysia <berlysia@gmail.com>",
  "main": "index.js",
  "license": "MIT",
  "lint-staged": {
    "*.{[jt]s,[jt]sx,[cm][jt]s}": [
      "oxlint --fix",
      "oxfmt"
    ],
    "*.{json,md}": [
      "oxfmt"
    ]
  },
  "type": "module",
  "scripts": {
    "dev": "vite",
    "serve": "run-s build serve:pages",
    "serve:pages": "cd dist && npx wrangler pages dev .",
    "build": "run-s build:seed build:og build:client build:ssg",
    "build:seed": "run-p 'build:seed:*'",
    "build:seed:local": "npx tsx app/seeds/localBuild.ts",
    "build:seed:remote": "npx tsx app/seeds/remoteBuild.ts",
    "build:og": "npx tsx scripts/prebuild-og.ts",
    "build:client": "vite build --mode client",
    "build:functions": "vite build --mode functions",
    "build:ssg": "vite build --mode ssg",
    "build:on-deploy": "run-s build copy-functions",
    "copy-functions": "cp -rT dist/functions functions || true",
    "start": "vite start",
    "lint": "oxlint --type-aware --max-warnings 0",
    "lint:fix": "oxlint --type-aware --fix",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "test": "echo 'No unit tests. VRT is available via `pnpm test:vrt` (heavy: needs dev server + docker). For quick checks use `pnpm typecheck` and `pnpm lint`.'",
    "test:vrt:ci": "playwright test",
    "test:vrt": "docker run --rm --volume $(pwd):/workdir/ --workdir /workdir/ -it mcr.microsoft.com/playwright:v1.41.2-focal /bin/bash -c 'pnpm run test:vrt:ci'",
    "test:vrt:update": "docker run --rm --volume $(pwd):/workdir/ --workdir /workdir/ -it mcr.microsoft.com/playwright:v1.41.2-focal /bin/bash -c 'pnpm run test:vrt:ci -u'",
    "clean": "run-p 'clean:*'",
    "clean:dist": "del dist",
    "clean:seed": "node app/seeds/clean.ts",
    "typecheck": "tsc --noEmit",
    "prepare": "git config --local core.hooksPath .githooks && echo 'githooks installed' || echo 'githooks install failed'",
    "precommit": "lint-staged"
  },
  "packageManager": "pnpm@10.34.9",
  "devDependencies": {
    "@cloudflare/workers-types": "5.20261107.1",
    "@hono/vite-ssg": "0.3.3",
    "@inquirer/prompts": "8.7.5",
    "@mdx-js/loader": "3.1.1",
    "@playwright/test": "1.62.1",
    "@resvg/resvg-js": "2.6.2",
    "@shikijs/rehype": "4.6.0",
    "@types/fs-extra": "11.0.4",
    "@types/hast": "3.0.5",
    "@types/mdast": "4.0.4",
    "@types/node": "24.13.3",
    "@types/unist": "3.0.3",
    "autoprefixer": "10.6.2",
    "del-cli": "7.0.0",
    "esbuild": "0.28.2",
    "feed": "6.0.0",
    "lint-staged": "16.4.0",
    "mdast-util-mdx-jsx": "3.2.1",
    "npm-run-all2": "8.0.4",
    "oxfmt": "0.77.0",
    "oxlint": "1.92.0",
    "oxlint-tsgolint": "7.0.2006",
    "playwright": "1.62.1",
    "postcss": "8.5.32",
    "tailwindcss": "3.4.19",
    "tailwindcss-logical": "3.0.1",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "wrangler": "4.158.0"
  },
  "dependencies": {
    "@fortawesome/fontawesome-svg-core": "7.3.1",
    "@fortawesome/free-solid-svg-icons": "7.3.1",
    "@fortawesome/react-fontawesome": "3.5.0",
    "@jsdevtools/rehype-toc": "3.0.2",
    "@mdx-js/mdx": "3.1.1",
    "budoux": "0.10.3",
    "cheerio": "1.2.0",
    "clsx": "2.1.1",
    "fs-extra": "11.4.1",
    "hono": "4.13.17",
    "honox": "0.1.62",
    "p-queue": "9.3.5",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "rehype-accessible-emojis": "0.3.2",
    "rehype-autolink-headings": "7.1.0",
    "rehype-slug": "6.0.0",
    "remark-frontmatter": "5.0.0",
    "remark-gfm": "4.0.1",
    "rss-parser": "3.13.0",
    "satori": "0.63.2",
    "to-vfile": "8.0.0",
    "unified": "11.0.5",
    "vfile-matter": "5.0.1",
    "vite": "7.3.7",
    "zod": "4.6.7"
  }
}
